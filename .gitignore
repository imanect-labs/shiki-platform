# Rust
/target
**/*.rs.bk

# 環境変数 / シークレット
.env
*.env
!*.env.example
# 手元に置く LLM プロバイダの API キー（giken-ops の tfvars / GitHub Secrets へ流す用の控え）。
/key

# Collabora のバージョンピン正本。シークレットではなく manifest（*.env の巻き添えを外す）。
# 除外されたままだと office-image.yml が source で落ち、Office 用イメージが一切ビルドされない。
!deploy/docker/collabora/office-manifest.env

# Node / Next.js
web/node_modules
web/.next
web/out
web/.turbo
node_modules

# codegen 生成物 (commit しない・スクリプトで再生成)
web/src/generated/

# Python
__pycache__/
*.pyc
.venv/

# OS / エディタ
.DS_Store
*.swp

# CI がビルド済み shiki-server バイナリを配置する場所（docker-compose.ci.yml が焼く）
deploy/compose/prebuilt/
crates/tabular/runner/target/
# 所有フォーク openjtd は独自 workspace なので target/ が別に生える
# （解読プローブ `cargo run -p rjtd-cli` をここで回したとき）。
vendor/openjtd/rjtd/target/

# Playwright の実行結果（リポジトリ直下で流したとき用・web/ 側は web/.gitignore が担当）
/test-results/
