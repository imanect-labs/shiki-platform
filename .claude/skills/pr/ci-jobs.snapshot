ci.yml.jobs.tabular-runner.steps[05].run = cargo build --manifest-path crates/tabular/runner/Cargo.toml --release
ci.yml.jobs.tabular-runner.steps[06].env.SHIKI_TABULAR_RUNNER = crates/tabular/runner/target/release/shiki-tabular-runner
