### ci.yml
ci.yml.env.CARGO_HTTP_MULTIPLEXING = false
ci.yml.env.CARGO_INCREMENTAL = 0
ci.yml.env.CARGO_NET_RETRY = 10
ci.yml.jobs.build-server.name = Build shiki-server (release・compose ジョブ共有)
ci.yml.jobs.build-server.steps[00].uses = actions/checkout
ci.yml.jobs.build-server.steps[00].with.persist-credentials = false
ci.yml.jobs.build-server.steps[01].name = free disk space (不要プリインストール削除)
ci.yml.jobs.build-server.steps[01].run = sudo rm -rf /usr/local/lib/android /usr/share/dotnet /opt/ghc /usr/local/.ghcup /opt/hostedtoolcache/CodeQL
ci.yml.jobs.build-server.steps[02].uses = dtolnay/rust-toolchain
ci.yml.jobs.build-server.steps[02].with.toolchain = 1.96.0
ci.yml.jobs.build-server.steps[03].uses = Swatinem/rust-cache
ci.yml.jobs.build-server.steps[03].with.shared-key = release-server
ci.yml.jobs.build-server.steps[04].env.CARGO_PROFILE_RELEASE_CODEGEN_UNITS = 256
ci.yml.jobs.build-server.steps[04].env.CARGO_PROFILE_RELEASE_OPT_LEVEL = 2
ci.yml.jobs.build-server.steps[04].run = cargo build --release --bin shiki-server
ci.yml.jobs.build-server.steps[05].uses = actions/upload-artifact
ci.yml.jobs.build-server.steps[05].with.if-no-files-found = error
ci.yml.jobs.build-server.steps[05].with.name = shiki-server-bin
ci.yml.jobs.build-server.steps[05].with.path = target/release/shiki-server
ci.yml.jobs.build-server.steps[05].with.retention-days = 1
ci.yml.jobs.cargo-deny.name = cargo-deny (advisories / licenses / bans / sources)
ci.yml.jobs.cargo-deny.steps[00].uses = actions/checkout
ci.yml.jobs.cargo-deny.steps[00].with.persist-credentials = false
ci.yml.jobs.cargo-deny.steps[01].uses = dtolnay/rust-toolchain
ci.yml.jobs.cargo-deny.steps[01].with.toolchain = 1.96.0
ci.yml.jobs.cargo-deny.steps[02].uses = Swatinem/rust-cache
ci.yml.jobs.cargo-deny.steps[03].uses = taiki-e/install-action
ci.yml.jobs.cargo-deny.steps[04].name = cargo deny check (advisories / licenses / bans / sources)
ci.yml.jobs.cargo-deny.steps[04].run = cargo deny --all-features check
ci.yml.jobs.compose-smoke.env.COMPOSE_FILE = docker-compose.yml:docker-compose.ci.yml
ci.yml.jobs.compose-smoke.name = compose smoke (/healthz, /me, skillex)
ci.yml.jobs.compose-smoke.needs[00] = build-server
ci.yml.jobs.compose-smoke.needs[01] = tabular-runner
ci.yml.jobs.compose-smoke.steps[00].uses = actions/checkout
ci.yml.jobs.compose-smoke.steps[01].uses = dtolnay/rust-toolchain
ci.yml.jobs.compose-smoke.steps[01].with.toolchain = 1.96.0
ci.yml.jobs.compose-smoke.steps[02].uses = Swatinem/rust-cache
ci.yml.jobs.compose-smoke.steps[03].name = download shiki-server binary (build-server の成果物)
ci.yml.jobs.compose-smoke.steps[03].uses = actions/download-artifact
ci.yml.jobs.compose-smoke.steps[03].with.name = shiki-server-bin
ci.yml.jobs.compose-smoke.steps[03].with.path = deploy/compose/prebuilt
ci.yml.jobs.compose-smoke.steps[04].name = download tabular runner binary (tabular-runner の成果物)
ci.yml.jobs.compose-smoke.steps[04].uses = actions/download-artifact
ci.yml.jobs.compose-smoke.steps[04].with.name = shiki-tabular-runner-bin
ci.yml.jobs.compose-smoke.steps[04].with.path = deploy/compose/prebuilt
ci.yml.jobs.compose-smoke.steps[05].background = true
ci.yml.jobs.compose-smoke.steps[05].env.SHIKI__RAG__ENABLED = false
ci.yml.jobs.compose-smoke.steps[05].id = compose-up
ci.yml.jobs.compose-smoke.steps[05].name = compose up (依存 + shiki-server → healthy 待ち)
ci.yml.jobs.compose-smoke.steps[05].run |
    cp .env.example .env
    docker compose up -d --build shiki-server
    for i in $(seq 1 60); do
    s=$(docker compose ps shiki-server --format '{{.Health}}' || true)
    echo "attempt $i: health=$s"
    [ "$s" = "healthy" ] && exit 0
    sleep 5
    done
    echo "shiki-server が healthy になりませんでした"; exit 1
ci.yml.jobs.compose-smoke.steps[05].working-directory = deploy/compose
ci.yml.jobs.compose-smoke.steps[06].name = authz 結合テストを先にコンパイル（compose 起動と並列）
ci.yml.jobs.compose-smoke.steps[06].run = cargo test -p shiki-authz --test check --no-run
ci.yml.jobs.compose-smoke.steps[07].name = wait for shiki-server healthy
ci.yml.jobs.compose-smoke.steps[07].wait = compose-up
ci.yml.jobs.compose-smoke.steps[08].name = smoke test (BFF code フロー)
ci.yml.jobs.compose-smoke.steps[08].run = bash smoke-bff.sh
ci.yml.jobs.compose-smoke.steps[08].working-directory = deploy/compose
ci.yml.jobs.compose-smoke.steps[09].name = smoke test (skillex)
ci.yml.jobs.compose-smoke.steps[09].run |
    set -euo pipefail
    echo "--- skillex client_credentials (aud=shiki-llm) ---"
    SK=$(curl -s -X POST http://localhost:8081/realms/shiki/protocol/openid-connect/token \
    -d grant_type=client_credentials -d client_id=skillex -d client_secret=skillex-dev-secret \
    | python3 -c "import sys,json;print(json.load(sys.stdin)['access_token'])")
    echo "$SK" | cut -d. -f2 | python3 -c "import sys,base64,json; p=sys.stdin.read().strip(); p+='='*(-len(p)%4); c=json.loads(base64.urlsafe_b64decode(p)); a=c.get('aud'); a=a if isinstance(a,list) else [a]; assert 'shiki-llm' in a, a; print('skillex aud OK:', a, 'azp=', c.get('azp'))"
ci.yml.jobs.compose-smoke.steps[09].working-directory = deploy/compose
ci.yml.jobs.compose-smoke.steps[10].env.OPENFGA_TEST_URL = http://localhost:8082
ci.yml.jobs.compose-smoke.steps[10].name = authz 結合テスト（live OpenFGA で allow/deny 検証）
ci.yml.jobs.compose-smoke.steps[10].run = cargo test -p shiki-authz --test check -- --nocapture
ci.yml.jobs.compose-smoke.steps[11].if = failure()
ci.yml.jobs.compose-smoke.steps[11].name = dump logs on failure
ci.yml.jobs.compose-smoke.steps[11].run = docker compose logs --no-color | tail -200
ci.yml.jobs.compose-smoke.steps[11].working-directory = deploy/compose
ci.yml.jobs.coverage.name = Coverage (cargo-llvm-cov, gate 80%)
ci.yml.jobs.coverage.steps[00].uses = actions/checkout
ci.yml.jobs.coverage.steps[01].name = free disk space (不要プリインストール削除)
ci.yml.jobs.coverage.steps[01].run = sudo rm -rf /usr/local/lib/android /usr/share/dotnet /opt/ghc /usr/local/.ghcup /opt/hostedtoolcache/CodeQL
ci.yml.jobs.coverage.steps[02].uses = dtolnay/rust-toolchain
ci.yml.jobs.coverage.steps[02].with.components = llvm-tools-preview
ci.yml.jobs.coverage.steps[02].with.toolchain = 1.96.0
ci.yml.jobs.coverage.steps[03].uses = Swatinem/rust-cache
ci.yml.jobs.coverage.steps[03].with.cache-on-failure = true
ci.yml.jobs.coverage.steps[04].uses = taiki-e/install-action
ci.yml.jobs.coverage.steps[05].background = true
ci.yml.jobs.coverage.steps[05].id = compose-up
ci.yml.jobs.coverage.steps[05].name = compose up (postgres + minio + openfga + redis + qdrant → healthy 待ち)
ci.yml.jobs.coverage.steps[05].run |
    cp .env.example .env
    docker compose up -d postgres minio openfga redis qdrant
    for svc in postgres minio openfga redis qdrant; do
    ok=""
    for i in $(seq 1 60); do
    s=$(docker compose ps "$svc" --format '{{.Health}}' || true)
    echo "[$svc] attempt $i: health=$s"
    [ "$s" = "healthy" ] && { ok=1; break; }
    sleep 5
    done
    [ -n "$ok" ] || { echo "$svc が healthy になりませんでした"; exit 1; }
    done
ci.yml.jobs.coverage.steps[05].working-directory = deploy/compose
ci.yml.jobs.coverage.steps[06].name = clean stale coverage artifacts
ci.yml.jobs.coverage.steps[06].run = cargo llvm-cov clean --workspace
ci.yml.jobs.coverage.steps[07].name = wait for services healthy
ci.yml.jobs.coverage.steps[07].wait = compose-up
ci.yml.jobs.coverage.steps[08].env.OPENFGA_TEST_URL = http://localhost:8082
ci.yml.jobs.coverage.steps[08].env.RAG_TEST_QDRANT_URL = http://localhost:6333
ci.yml.jobs.coverage.steps[08].env.REDIS_TEST_URL = redis://localhost:6379
ci.yml.jobs.coverage.steps[08].env.STORAGE_TEST_DATABASE_URL = postgres://postgres:postgres@localhost:5432/shiki
ci.yml.jobs.coverage.steps[08].env.STORAGE_TEST_S3_ENDPOINT = http://localhost:9000
ci.yml.jobs.coverage.steps[08].name = test + coverage (cargo-llvm-cov)
ci.yml.jobs.coverage.steps[08].run = cargo llvm-cov --all --no-report
ci.yml.jobs.coverage.steps[09].name = coverage report (lcov + summary + job summary)
ci.yml.jobs.coverage.steps[09].run |
    cargo llvm-cov report --lcov --output-path lcov.info --ignore-filename-regex 'src/(bin/|main\.rs)|vendor/secure-exec/|sandbox-orchestrator/src/backend/wasm/|sandbox-orchestrator/src/backend/(gvisor|firecracker)/(instance|mod)\.rs|sandbox-guest-agent/src/vsock\.rs|sandbox-netns/src/lib\.rs|sandbox-client/src/client\.rs'
    # サマリ表を再利用するためファイルに保存（Job Summary と PR コメントの両方で使う）。
    cargo llvm-cov report --summary-only --ignore-filename-regex 'src/(bin/|main\.rs)|vendor/secure-exec/|sandbox-orchestrator/src/backend/wasm/|sandbox-orchestrator/src/backend/(gvisor|firecracker)/(instance|mod)\.rs|sandbox-guest-agent/src/vsock\.rs|sandbox-netns/src/lib\.rs|sandbox-client/src/client\.rs' | tee coverage-summary.txt
    {
    echo '### Rust test coverage'
    echo '```'
    cat coverage-summary.txt
    echo '```'
    } >> "$GITHUB_STEP_SUMMARY"
ci.yml.jobs.coverage.steps[10].env.GH_TOKEN = ${{ secrets.GITHUB_TOKEN }}
ci.yml.jobs.coverage.steps[10].env.PR = ${{ github.event.pull_request.number }}
ci.yml.jobs.coverage.steps[10].if = ${{ always() && github.event_name == 'pull_request' }}
ci.yml.jobs.coverage.steps[10].name = comment coverage table on PR
ci.yml.jobs.coverage.steps[10].run |
    [ -f coverage-summary.txt ] || { echo "サマリ未生成のためスキップ"; exit 0; }
    marker='<!-- coverage-report -->'
    total_line=$(grep '^TOTAL' coverage-summary.txt || true)
    {
    echo "$marker"
    echo '## 📊 Rust test coverage'
    echo "閾値ゲート: 行 **80%** 以上（\`cargo llvm-cov --fail-under-lines 80\`）"
    echo
    if [ -n "$total_line" ]; then
    echo '```'
    echo "$total_line"
    echo '```'
    fi
    echo '<details>'
    echo '<summary>ファイル別内訳を表示</summary>'
    echo
    echo '```'
    cat coverage-summary.txt
    echo '```'
    echo '</details>'
    } > body.md
    body="$(cat body.md)"
    existing=$(gh api "repos/${GITHUB_REPOSITORY}/issues/${PR}/comments" \
    --jq "[.[] | select(.user.login==\"github-actions[bot]\" and (.body | startswith(\"${marker}\")))] | last | .id")
    if [ -n "$existing" ] && [ "$existing" != "null" ]; then
    gh api "repos/${GITHUB_REPOSITORY}/issues/comments/${existing}" -X PATCH -f body="$body" >/dev/null
    echo "既存コメントを更新: $existing"
    else
    gh api "repos/${GITHUB_REPOSITORY}/issues/${PR}/comments" -f body="$body" >/dev/null
    echo "新規コメントを作成"
    fi
ci.yml.jobs.coverage.steps[11].name = coverage gate (fail under 80% lines)
ci.yml.jobs.coverage.steps[11].run = cargo llvm-cov report --fail-under-lines 80 --ignore-filename-regex 'src/(bin/|main\.rs)|vendor/secure-exec/|sandbox-orchestrator/src/backend/wasm/|sandbox-orchestrator/src/backend/(gvisor|firecracker)/(instance|mod)\.rs|sandbox-guest-agent/src/vsock\.rs|sandbox-netns/src/lib\.rs|sandbox-client/src/client\.rs'
ci.yml.jobs.coverage.steps[12].name = upload coverage (lcov)
ci.yml.jobs.coverage.steps[12].uses = actions/upload-artifact
ci.yml.jobs.coverage.steps[12].with.if-no-files-found = error
ci.yml.jobs.coverage.steps[12].with.name = coverage-lcov
ci.yml.jobs.coverage.steps[12].with.path = lcov.info
ci.yml.jobs.coverage.steps[13].if = failure()
ci.yml.jobs.coverage.steps[13].name = dump compose logs on failure
ci.yml.jobs.coverage.steps[13].run = docker compose logs --no-color | tail -200
ci.yml.jobs.coverage.steps[13].working-directory = deploy/compose
ci.yml.jobs.python.defaults.run.working-directory = ingestion-worker
ci.yml.jobs.python.name = Python (ingestion-worker ruff / pytest)
ci.yml.jobs.python.steps[00].uses = actions/checkout
ci.yml.jobs.python.steps[00].with.persist-credentials = false
