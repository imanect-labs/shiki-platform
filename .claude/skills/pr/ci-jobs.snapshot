ci.yml.jobs.web-e2e.steps[06].with.cache-dependency-path = web/pnpm-lock.yaml
ci.yml.jobs.web-e2e.steps[06].with.node-version = 22
ci.yml.jobs.web-e2e.steps[07].background = true
ci.yml.jobs.web-e2e.steps[07].env.SHIKI__AUTH__POST_LOGOUT_REDIRECT_URI = http://localhost:3000/
ci.yml.jobs.web-e2e.steps[07].env.SHIKI__AUTH__REDIRECT_URI = http://localhost:3000/auth/callback
ci.yml.jobs.web-e2e.steps[07].env.SHIKI__RAG__ENABLED = false
ci.yml.jobs.web-e2e.steps[07].id = compose-up
ci.yml.jobs.web-e2e.steps[07].name = compose up (keycloak + shiki-server → healthy 待ち)
ci.yml.jobs.web-e2e.steps[07].run |
    cp .env.example .env
    docker compose up -d --build shiki-server
    for i in $(seq 1 60); do
    s=$(docker compose ps shiki-server --format '{{.Health}}' || true)
    echo "attempt $i: health=$s"
    [ "$s" = "healthy" ] && exit 0
    sleep 5
    done
    echo "shiki-server が healthy になりませんでした"; exit 1
ci.yml.jobs.web-e2e.steps[07].working-directory = deploy/compose
ci.yml.jobs.web-e2e.steps[08].name = install (web)
ci.yml.jobs.web-e2e.steps[08].run = pnpm install --frozen-lockfile
ci.yml.jobs.web-e2e.steps[08].working-directory = web
ci.yml.jobs.web-e2e.steps[09].name = gen:api (Rust 定義から型生成)
ci.yml.jobs.web-e2e.steps[09].run = pnpm gen:api
ci.yml.jobs.web-e2e.steps[09].working-directory = web
ci.yml.jobs.web-e2e.steps[10].name = build (web)
ci.yml.jobs.web-e2e.steps[10].run = pnpm build
ci.yml.jobs.web-e2e.steps[10].working-directory = web
ci.yml.jobs.web-e2e.steps[11].name = install Playwright browser
ci.yml.jobs.web-e2e.steps[11].run = pnpm exec playwright install --with-deps chromium
ci.yml.jobs.web-e2e.steps[11].working-directory = web
ci.yml.jobs.web-e2e.steps[12].name = wait for shiki-server healthy
ci.yml.jobs.web-e2e.steps[12].wait = compose-up
ci.yml.jobs.web-e2e.steps[13].env.BACKEND_ORIGIN = http://localhost:8080
ci.yml.jobs.web-e2e.steps[13].env.CI = true
ci.yml.jobs.web-e2e.steps[13].name = run E2E (BFF + Keycloak 実フロー)
ci.yml.jobs.web-e2e.steps[13].run = pnpm e2e
ci.yml.jobs.web-e2e.steps[13].working-directory = web
ci.yml.jobs.web-e2e.steps[14].if = failure()
ci.yml.jobs.web-e2e.steps[14].name = upload Playwright report on failure
ci.yml.jobs.web-e2e.steps[14].uses = actions/upload-artifact
ci.yml.jobs.web-e2e.steps[14].with.if-no-files-found = ignore
ci.yml.jobs.web-e2e.steps[14].with.name = playwright-report
ci.yml.jobs.web-e2e.steps[14].with.path = web/playwright-report
ci.yml.jobs.web-e2e.steps[15].if = failure()
ci.yml.jobs.web-e2e.steps[15].name = dump compose logs on failure
ci.yml.jobs.web-e2e.steps[15].run = docker compose logs --no-color | tail -200
ci.yml.jobs.web-e2e.steps[15].working-directory = deploy/compose
ci.yml.name = CI
ci.yml.on.pull_request.paths-ignore[00] = docs/**
ci.yml.on.pull_request.paths-ignore[01] = **.md
ci.yml.on.pull_request.paths-ignore[02] = .claude/**
ci.yml.on.push.branches[00] = main
ci.yml.on.push.paths-ignore[00] = docs/**
ci.yml.on.push.paths-ignore[01] = **.md
ci.yml.on.push.paths-ignore[02] = .claude/**

### docker-image.yml
docker-image.yml.jobs.build-prod-image.name = prod イメージビルド検証 (deploy/Dockerfile)
docker-image.yml.jobs.build-prod-image.steps[00].uses = actions/checkout
docker-image.yml.jobs.build-prod-image.steps[00].with.persist-credentials = false
docker-image.yml.jobs.build-prod-image.steps[01].name = free disk space (不要プリインストール削除)
docker-image.yml.jobs.build-prod-image.steps[01].run = sudo rm -rf /usr/local/lib/android /usr/share/dotnet /opt/ghc /usr/local/.ghcup /opt/hostedtoolcache/CodeQL
docker-image.yml.jobs.build-prod-image.steps[02].name = docker build (shiki-server 本番イメージ)
docker-image.yml.jobs.build-prod-image.steps[02].run = docker build -f deploy/Dockerfile .
docker-image.yml.name = docker-image
docker-image.yml.on.pull_request.paths[00] = deploy/Dockerfile
docker-image.yml.on.pull_request.paths[01] = deploy/Dockerfile.ci
docker-image.yml.on.pull_request.paths[02] = deploy/docker/**
docker-image.yml.on.pull_request.paths[03] = !deploy/docker/collabora/**
docker-image.yml.on.pull_request.paths[04] = deploy/compose/docker-compose*.yml

### office-image.yml
office-image.yml.jobs.build-and-push.name = Collabora ソースビルド → GHCR push
office-image.yml.jobs.build-and-push.steps[00].uses = actions/checkout
office-image.yml.jobs.build-and-push.steps[00].with.persist-credentials = false
office-image.yml.jobs.build-and-push.steps[01].name = free disk space (不要プリインストール削除)
office-image.yml.jobs.build-and-push.steps[01].run = sudo rm -rf /usr/local/lib/android /usr/share/dotnet /opt/ghc /usr/local/.ghcup /opt/hostedtoolcache/CodeQL
office-image.yml.jobs.build-and-push.steps[02].name = manifest 読み込み（タグ＋コミットの二重ピンが正）
office-image.yml.jobs.build-and-push.steps[02].run |
    set -euo pipefail
    source deploy/docker/collabora/office-manifest.env
    for v in CORE_REPO CORE_REF CORE_COMMIT ONLINE_REPO ONLINE_REF ONLINE_COMMIT; do
    [ -n "${!v}" ] || { echo "manifest に $v が無い"; exit 1; }
    echo "$v=${!v}" >> "$GITHUB_ENV"
    done
office-image.yml.jobs.build-and-push.steps[03].uses = docker/setup-buildx-action
office-image.yml.jobs.build-and-push.steps[04].uses = docker/login-action
office-image.yml.jobs.build-and-push.steps[04].with.password = ${{ secrets.GITHUB_TOKEN }}
office-image.yml.jobs.build-and-push.steps[04].with.registry = ghcr.io
office-image.yml.jobs.build-and-push.steps[04].with.username = ${{ github.actor }}
office-image.yml.jobs.build-and-push.steps[05].name = build & push
office-image.yml.jobs.build-and-push.steps[05].uses = docker/build-push-action
office-image.yml.jobs.build-and-push.steps[05].with.build-args |
    CORE_REPO=${{ env.CORE_REPO }}
    CORE_REF=${{ env.CORE_REF }}
    CORE_COMMIT=${{ env.CORE_COMMIT }}
    ONLINE_REPO=${{ env.ONLINE_REPO }}
    ONLINE_REF=${{ env.ONLINE_REF }}
    ONLINE_COMMIT=${{ env.ONLINE_COMMIT }}
office-image.yml.jobs.build-and-push.steps[05].with.context = deploy/docker/collabora
office-image.yml.jobs.build-and-push.steps[05].with.labels |
    org.opencontainers.image.source=${{ github.server_url }}/${{ github.repository }}
    org.opencontainers.image.licenses=MPL-2.0
    io.shiki.collabora.core=${{ env.CORE_REF }}@${{ env.CORE_COMMIT }}
    io.shiki.collabora.online=${{ env.ONLINE_REF }}@${{ env.ONLINE_COMMIT }}
office-image.yml.jobs.build-and-push.steps[05].with.push = true
office-image.yml.jobs.build-and-push.steps[05].with.tags |
    ghcr.io/${{ github.repository_owner }}/shiki-collabora:${{ env.ONLINE_REF }}
    ghcr.io/${{ github.repository_owner }}/shiki-collabora:latest
office-image.yml.jobs.build-and-push.steps[06].name = smoke（discovery が取れること）
office-image.yml.jobs.build-and-push.steps[06].run |
    set -euo pipefail
    docker run -d --rm --name collabora-smoke -p 127.0.0.1:19980:9980 \
    "ghcr.io/${{ github.repository_owner }}/shiki-collabora:${ONLINE_REF}" \
    coolwsd --o:sys_template_path=/opt/cool/systemplate \
    --o:child_root_path=/opt/cool/child-roots \
    --o:lo_template_path=/opt/collaboraoffice \
    --o:ssl.enable=false --o:ssl.termination=false
    for i in $(seq 1 60); do
    if curl -fsS http://127.0.0.1:19980/hosting/discovery | grep -q 'urlsrc'; then
    echo "discovery OK"; docker stop collabora-smoke; exit 0
    fi
    sleep 2
    done
    echo "discovery が 120 秒で応答しない"; docker logs collabora-smoke; exit 1
office-image.yml.name = office-image
office-image.yml.on.push.branches[00] = main
office-image.yml.on.push.paths[00] = deploy/docker/collabora/**
office-image.yml.on.push.paths[01] = .github/workflows/office-image.yml
office-image.yml.on.schedule[00].cron = 0 18 * * 1
office-image.yml.on.workflow_dispatch = ~
