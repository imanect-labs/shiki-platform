ci.yml.jobs.rust.name = Rust (fmt / clippy / test / build)
ci.yml.jobs.rust.steps[00].uses = actions/checkout
ci.yml.jobs.rust.steps[01].name = free disk space (不要プリインストール削除)
ci.yml.jobs.rust.steps[01].run |
    sudo rm -rf /usr/local/lib/android /usr/share/dotnet /opt/ghc /usr/local/.ghcup /opt/hostedtoolcache/CodeQL
    df -h /
ci.yml.jobs.rust.steps[02].uses = dtolnay/rust-toolchain
ci.yml.jobs.rust.steps[02].with.components = rustfmt, clippy
ci.yml.jobs.rust.steps[02].with.toolchain = 1.96.0
ci.yml.jobs.rust.steps[03].uses = Swatinem/rust-cache
ci.yml.jobs.rust.steps[04].uses = taiki-e/install-action
ci.yml.jobs.rust.steps[05].run = cargo fmt --all --check
ci.yml.jobs.rust.steps[06].run = cargo clippy --all-targets --all-features -- -D warnings
ci.yml.jobs.rust.steps[07].run = cargo nextest run --workspace --all-features
ci.yml.jobs.sandbox-gvisor.continue-on-error = true
ci.yml.jobs.sandbox-gvisor.name = Sandbox gVisor IT (runsc・非ブロッキング)
ci.yml.jobs.sandbox-gvisor.steps[00].uses = actions/checkout
ci.yml.jobs.sandbox-gvisor.steps[00].with.persist-credentials = false
ci.yml.jobs.sandbox-gvisor.steps[01].name = free disk space (不要プリインストール削除)
ci.yml.jobs.sandbox-gvisor.steps[01].run |
    sudo rm -rf /usr/local/lib/android /usr/share/dotnet /opt/ghc /usr/local/.ghcup /opt/hostedtoolcache/CodeQL
    df -h /
ci.yml.jobs.sandbox-gvisor.steps[02].name = allow unprivileged userns (AppArmor)
ci.yml.jobs.sandbox-gvisor.steps[02].run = sudo sysctl -w kernel.apparmor_restrict_unprivileged_userns=0 || true
ci.yml.jobs.sandbox-gvisor.steps[03].uses = dtolnay/rust-toolchain
ci.yml.jobs.sandbox-gvisor.steps[03].with.toolchain = 1.96.0
ci.yml.jobs.sandbox-gvisor.steps[04].uses = Swatinem/rust-cache
ci.yml.jobs.sandbox-gvisor.steps[05].name = fetch runsc (manifest 検証・PIT-33)
ci.yml.jobs.sandbox-gvisor.steps[05].run = bash scripts/fetch-native-assets.sh
ci.yml.jobs.sandbox-gvisor.steps[06].name = build rootfs (numpy/pandas 同梱・--require-hashes)
ci.yml.jobs.sandbox-gvisor.steps[06].run = bash scripts/build-sandbox-rootfs.sh
ci.yml.jobs.sandbox-gvisor.steps[07].env.GVISOR_ROOTFS = ${{ github.workspace }}/deploy/sandbox-assets/rootfs
ci.yml.jobs.sandbox-gvisor.steps[07].env.RUNSC_BIN = ${{ github.workspace }}/deploy/sandbox-assets/bin/runsc
ci.yml.jobs.sandbox-gvisor.steps[07].env.SANDBOX_GVISOR_IT = 1
ci.yml.jobs.sandbox-gvisor.steps[07].name = gvisor gated IT (create/exec/numpy/watchdog)
ci.yml.jobs.sandbox-gvisor.steps[07].run = cargo test -p shiki-sandbox-orchestrator --test gvisor_it -- --test-threads=1
ci.yml.jobs.tabular-runner.name = Tabular runner (隔離 DuckDB・PIT-39 adversarial)
ci.yml.jobs.tabular-runner.steps[00].uses = actions/checkout
ci.yml.jobs.tabular-runner.steps[01].name = free disk space (不要プリインストール削除)
ci.yml.jobs.tabular-runner.steps[01].run |
