# shiki-platform compose 環境変数のサンプル。`.env` にコピーして使う。

# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- Keycloak 管理者 ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# ブラウザからアクセスする Keycloak の公開 URL（トークンの iss になる）。
KC_PUBLIC_URL=http://localhost:8081

# --- RustFS (S3 互換オブジェクトストア) ---
# MinIO から差し替えた。経緯は docker-compose.yml の rustfs サービスのコメント。
RUSTFS_ACCESS_KEY=minioadmin
RUSTFS_SECRET_KEY=minioadmin

# --- shiki-server ---
# OIDC issuer はブラウザがログインする公開 URL に一致させる（authorize/ログアウトのリダイレクト先）。
SHIKI__AUTH__ISSUER=http://localhost:8081/realms/shiki
# サーバ側 OIDC 呼び出し（token 交換・JWKS）はコンテナ内部 URL を使う。
SHIKI__AUTH__INTERNAL_BASE_URL=http://keycloak:8080/realms/shiki
SHIKI__AUTH__AUDIENCE=shiki-api
# テナンシー: multi（SaaS）は JWT claim `tenant` 由来の tenant_id で Postgres レイヤを分離する。
# alice/bob=tenant a-corp・charlie=tenant b-corp（realm の tenant 属性）。テナント分離の検証用。
# single（オンプレ/cell）にする場合は SHIKI__AUTH__TENANT_ID の固定値を使う。
# multi は SaaS 本番でもそのまま使える（全隔離層が tenant_id スコープ。旧 dev 専用ゲート
# SHIKI_DEV_ALLOW_MULTI_TENANT は SAAS.1 完了で撤去済み・crates/api/src/config.rs）。
SHIKI__AUTH__TENANCY=multi
# BFF（confidential client）。client_secret はサーバ側でのみ保持する（ブラウザに出さない）。
SHIKI__AUTH__CLIENT_ID=shiki-web
SHIKI__AUTH__CLIENT_SECRET=shiki-web-dev-secret
# OIDC code フローの redirect_uri。web 同一オリジン運用は http://localhost:3000/auth/callback。
# web 無しの smoke では api 自身（http://localhost:8080/auth/callback）。
SHIKI__AUTH__REDIRECT_URI=http://localhost:8080/auth/callback
SHIKI__AUTH__POST_LOGOUT_REDIRECT_URI=http://localhost:8080/

# --- 構造化データ（Phase 15・docs/data-platform.md）---
# keyset カーソル（内部キーを含む不透明トークン）の AES-256-GCM 鍵。全レプリカで同じ鍵が要る。
# 決め方: SHIKI__DATA__CURSOR_KEY_FILE（32 バイト生 or base64 の鍵ファイル）→ 無ければ
# SHIKI__SECRETS__MASTER_KEY_FILE から用途別に導出 → どちらも無く EPHEMERAL_CURSOR_KEY=true なら起動時乱数
# （**開発専用**: 再起動・レプリカ間でカーソルが無効になる）→ それ以外は起動エラー。
# 本番では鍵ファイルをマウントし、下の EPHEMERAL を false にする（CURSOR_KEY_FILE は compose の shiki-server へ渡してある）。
SHIKI__DATA__EPHEMERAL_CURSOR_KEY=true
#SHIKI__DATA__CURSOR_KEY_FILE=/run/secrets/data_cursor_key
#SHIKI__SECRETS__MASTER_KEY_FILE=/run/secrets/master_key
# レコード変更の SSE 配信。購読中の認可材料の TTL（ミリ秒・既定 5000・100〜60000）＝権限剥奪の配信への反映の
# 最大遅延（製品の約束・PIT-70）と、ストリームの保持期間（秒・既定 600・60〜86400。これより古い位置からの再開は
# stream.reset、スナップショット読取は 410）。範囲外は起動エラー。compose の shiki-server へ渡してある（空なら既定）。
#SHIKI__DATA__STREAM__AUTHZ_TTL_MS=5000
#SHIKI__DATA__STREAM__RETENTION_SECS=600

# --- BFF セッション (Redis) ---
# ローカル HTTP 開発では Cookie の Secure を無効化する（本番 HTTPS は true）。
SHIKI__SESSION__SECURE=false

# 開発/E2E 用: 起動時に固定ユーザー群（alice/bob=a-corp・charlie=b-corp）の
# org member tuple ＋ 組織管理者（alice）・監査閲覧者（alice・charlie）の tuple ＋
# ユーザーディレクトリ（共有相手検索）を seed する。
# realm の sub / tenant 属性 / groups と一致させること（crates/api/src/dev_seed.rs SEED_USERS）。
# SHIKI_DEV_SEED=true のときのみ作動する（本番では設定しないこと＝権限昇格経路のため）。
SHIKI_DEV_SEED=true

# --- 地図（回答の ```ui の map の背景・外部接続必須機能 / requirements NFR-2） ---
# 未設定なら地図の背景を出さず、位置関係だけの静止画を描く（エアギャップでも動く）。
# MapLibre のスタイル JSON の URL（OpenFreeMap・自前のタイル配信）。配色は web が明暗に合わせて塗り直す。
# SHIKI__MAP__STYLE_URL_LIGHT=https://tiles.openfreemap.org/styles/liberty
# SHIKI__MAP__STYLE_URL_DARK=

# --- 監視（observability profile・オプトイン） ---
# 監視スタックを使う時だけ有効化する:
#   OTLP_ENDPOINT=http://otel-collector:4317 docker compose --profile observability up -d
# 空 = OTel エクスポート無効（開発機の RAM 節約のための既定）。
OTLP_ENDPOINT=

# --- RAG（Phase 2） ---
# false にするとインジェスト・パイプラインと POST /search を無効化できる。
SHIKI__RAG__ENABLED=true
# 埋め込みモデル版。インデックス（Qdrant collection / Tantivy index）単位で固定され、
# 変更時は shadow index を再構築して alias を切り替える（docs/design.md §4.3 PIT-8）。
SHIKI__RAG__EMBEDDING_MODEL_VERSION=cl-nagoya/ruri-v3-30m
# reranker へ渡す候補数（既定 16。品質を優先するなら 32・遅さは候補数に比例する・#561）。
#SHIKI__RAG__RERANK_POOL=16
# reranker の生スコアがこれ未満のヒットを結果から落とす（既定は足切りしない・#100）。
#SHIKI__RAG__MIN_RERANK_SCORE=0.45
# 検索結果の関連度ラベル（高/中/低）の閾値。reranker のスコアのスケールに依存するので、
# worker の RERANK_MODEL を替えたら実クエリで測り直し、RELEVANCE_MODEL も揃える（#424）。
#SHIKI__RAG__RELEVANCE_HIGH=0.55
#SHIKI__RAG__RELEVANCE_LOW=0.45
#SHIKI__RAG__RELEVANCE_MODEL=hotchpotch/japanese-reranker-cross-encoder-xsmall-v1
# 監査に残す検索語ハッシュの鍵（32 バイト以上・#833。例: openssl rand -hex 32）。監査閲覧者が
# 検索語からハッシュを計算して「この語で検索した人がいるか」を確かめられないよう、サーバだけが持つ。
# 未設定は起動時乱数（再起動・別レプリカとは同じ語でも値が揃わない）。
#SHIKI__RAG__QUERY_HASH_KEY=
#RERANK_MODEL=hotchpotch/japanese-reranker-cross-encoder-xsmall-v1
# 内部サービスの認証（#812）。全テナントのベクタが 1 collection にあるため、ネットワーク到達性を
# 信頼の根拠にしない。下の値は dev 用の固定文字列で、**本番では必ず推測できない値に差し替える**
# （例: `openssl rand -hex 32`）。compose が Qdrant/worker と shiki-server の両方へ同じ値を渡す。
# Qdrant の API キー（QDRANT__SERVICE__API_KEY ⇔ SHIKI__RAG__QDRANT_API_KEY）。空にしないこと。
QDRANT_API_KEY=shiki-qdrant-dev-key
# ingestion-worker の共有トークン（WORKER_AUTH_TOKEN ⇔ SHIKI__RAG__WORKER_AUTH_TOKEN）。
INGESTION_WORKER_AUTH_TOKEN=shiki-worker-dev-token
# worker の /parse が source_url で取りに行ってよいホスト（presigned URL の発行元）。
# カンマ区切りで `host` か `host:port`。外部 S3/GCS を使うならそのホストに替える。
#INGESTION_SOURCE_URL_ALLOWED_HOSTS=rustfs:9000
