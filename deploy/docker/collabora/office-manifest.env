# Collabora Online 自前ビルドのバージョンピン（正本）。
#
# リリースタグ＋peel 済みコミット SHA の二重ピン（PIT-33/PIT-43）。Dockerfile は
# クローン直後に `git rev-parse HEAD` が期待 SHA と一致しなければ失敗するため、
# 上流でのタグ付け替えを検知できる。
#
# 更新手順は README.md 参照。
# 値は Dockerfile の ARG 既定値と一致させる（office-image.yml は本ファイルを正として
# --build-arg で上書きする）。
#
# シークレットではないので必ずコミットする（.gitignore の `*.env` に巻き込まれると
# office-image.yml が source に失敗し、Office 用イメージが一切ビルドされない）。

# 26.04 から core は online のリポジトリの engine/ に入った（monorepo）。online だけをピンする。
# online.git には 26.04 のタグが無く、gerrit.collaboraoffice.com の公開ミラー online.mirror に
# 出ている。core の gerrit（git.libreoffice.org）にも cp-26.04 のタグは無い（2026-10-17 確認）。
ONLINE_REPO=https://github.com/CollaboraOnline/online.mirror.git
ONLINE_REF=cp-26.04.5-1
ONLINE_COMMIT=22ce52fb5173821dd90782638afcbfb6b6d7cb40

# **engine の翻訳（日本語など）は別のリポジトリ。** monorepo には含まれず、無いと configure は
# 黙って英語だけでビルドする（engine が描くダイアログ・サイドバー・スタイル名が英語になる）。
# online と同じタグをピンし、engine/translations へ取り込む。
TRANSLATIONS_REPO=https://gerrit.collaboraoffice.com/translations
TRANSLATIONS_REF=cp-26.04.5-1
TRANSLATIONS_COMMIT=ed43817bd4972e81feb228a0ad06a8aa783d3f55

# **Poco は 26.04 から engine の外部ライブラリとして建つ**（online の configure は
# --with-poco-* を無視する）。版と sha256 は engine の external/tarballs が持ち、
# イメージの core-external-tarballs.sha256 に記録される。

# **Node は 20 以上が要る**（online の configure）。Ubuntu 24.04 の nodejs は 18。
# 公式の tarball を sha256 で固定する（SHASUMS256.txt の値）。
NODE_URL=https://nodejs.org/dist/v22.23.3/node-v22.23.3-linux-x64.tar.xz
NODE_SHA256=df450af89261115ef9f9e3830c3eeb2cc9213b63c720b1af623cb5dcbe2e02de
