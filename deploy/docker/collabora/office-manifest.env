# Collabora Online 自前ビルドのバージョンピン（正本）。
#
# リリースタグ＋peel 済みコミット SHA の二重ピン（PIT-33/PIT-43）。Dockerfile は
# クローン直後に `git rev-parse HEAD` が期待 SHA と一致しなければ失敗するため、
# 上流でのタグ付け替えを検知できる。
#
# core と online は同一トレイン（cp-XX.YY.x）を選ぶこと。更新手順は README.md 参照。
# 値は Dockerfile の ARG 既定値と一致させる（office-image.yml は本ファイルを正として
# --build-arg で上書きする）。
#
# シークレットではないので必ずコミットする（.gitignore の `*.env` に巻き込まれると
# office-image.yml が source に失敗し、Office 用イメージが一切ビルドされない）。

CORE_REPO=https://git.libreoffice.org/core
CORE_REF=cp-25.04.9-4
CORE_COMMIT=bbf180856f1919e69a04fdf6175ff4f11f52e1db

ONLINE_REPO=https://github.com/CollaboraOnline/online.git
ONLINE_REF=cp-25.04.9-5
ONLINE_COMMIT=53f91c25641febb11d77702380530775a923890e
