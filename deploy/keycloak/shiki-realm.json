{
  "realm": "shiki",
  "enabled": true,
  "displayName": "Shiki",
  "loginTheme": "shiki",
  "internationalizationEnabled": true,
  "supportedLocales": [
    "ja"
  ],
  "defaultLocale": "ja",
  "sslRequired": "none",
  "registrationAllowed": false,
  "accessTokenLifespan": 1800,
  "browserFlow": "shiki browser",
  "webAuthnPolicyPasswordlessRpEntityName": "Shiki",
  "webAuthnPolicyPasswordlessRequireResidentKey": "Yes",
  "webAuthnPolicyPasswordlessUserVerificationRequirement": "required",
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "authenticationFlows": [
    {
      "alias": "shiki browser",
      "description": "Shiki のブラウザログイン。パスワード（＋設定済みなら OTP）とパスキーを同じ段の選択肢に置く。",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false,
          "autheticatorFlow": false,
          "authenticator": "auth-cookie"
        },
        {
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false,
          "autheticatorFlow": false,
          "authenticator": "identity-provider-redirector"
        },
        {
          "requirement": "ALTERNATIVE",
          "priority": 30,
          "userSetupAllowed": false,
          "autheticatorFlow": true,
          "flowAlias": "shiki browser forms"
        }
      ]
    },
    {
      "alias": "shiki browser forms",
      "description": "ログインフォーム（パスワード or パスキー）",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false,
          "autheticatorFlow": true,
          "flowAlias": "shiki browser password"
        },
        {
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false,
          "autheticatorFlow": true,
          "flowAlias": "shiki browser passkey"
        }
      ]
    },
    {
      "alias": "shiki browser password",
      "description": "ユーザー名＋パスワード。OTP を設定済みなら 2 段目で求める。",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "autheticatorFlow": false,
          "authenticator": "auth-username-password-form"
        },
        {
          "requirement": "CONDITIONAL",
          "priority": 20,
          "userSetupAllowed": false,
          "autheticatorFlow": true,
          "flowAlias": "shiki browser otp"
        }
      ]
    },
    {
      "alias": "shiki browser otp",
      "description": "OTP を設定済みのユーザーだけ確認コードを求める",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "autheticatorFlow": false,
          "authenticator": "conditional-user-configured"
        },
        {
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false,
          "autheticatorFlow": false,
          "authenticator": "auth-otp-form"
        }
      ]
    },
    {
      "alias": "shiki browser passkey",
      "description": "パスキー（discoverable credential）でパスワードなしにログイン",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "autheticatorFlow": false,
          "authenticator": "webauthn-authenticator-passwordless"
        }
      ]
    }
  ],
  "groups": [
    {
      "name": "tenants",
      "path": "/tenants",
      "subGroups": [
        {
          "name": "a-corp",
          "path": "/tenants/a-corp",
          "subGroups": [
            {
              "name": "a-corp",
              "path": "/tenants/a-corp/a-corp"
            }
          ]
        },
        {
          "name": "b-corp",
          "path": "/tenants/b-corp",
          "subGroups": [
            {
              "name": "b-corp",
              "path": "/tenants/b-corp/b-corp"
            }
          ]
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "shiki-web",
      "name": "shiki web frontend (BFF confidential client)",
      "description": "メイン Web の BFF（crates/api）が code↔token 交換をサーバ側で行う confidential client。ブラウザにトークンは置かない（docs/auth/browser-token-strategy.md / #55）。",
      "enabled": true,
      "publicClient": false,
      "secret": "shiki-web-dev-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:8080/*",
        "http://localhost:10067/*",
        "http://shuya-dev:10067/*"
      ],
      "webOrigins": [
        "+"
      ],
      "rootUrl": "http://localhost:3000",
      "baseUrl": "http://localhost:3000",
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+",
        "backchannel.logout.url": "http://localhost:10067/auth/backchannel-logout",
        "backchannel.logout.session.required": "true",
        "backchannel.logout.revoke.offline.tokens": "false"
      },
      "protocolMappers": [
        {
          "name": "shiki-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "shiki-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "full.path": "true",
            "claim.name": "groups",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "roles",
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "tenant",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "tenant",
            "claim.name": "tenant",
            "jsonType.label": "String",
            "multivalued": "false",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "skillex",
      "name": "skillex service (llm-gateway m2m)",
      "description": "skillex（外部クライアント）が llm-gateway を machine-to-machine で呼ぶための client（client_credentials・aud=shiki-llm）。テナント属性は持たない。詳細は docs/auth/skillex-identity.md。",
      "enabled": true,
      "publicClient": false,
      "secret": "skillex-dev-secret",
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "redirectUris": [],
      "protocolMappers": [
        {
          "name": "shiki-llm-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "shiki-llm",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "shiki-provisioner",
      "name": "shiki tenant provisioner (SAAS.2)",
      "description": "テナント・プロビジョニング用 service account。shiki-server の /admin/* 呼び出し（azp 照合）と Keycloak admin REST（ユーザー/グループ管理）に使う。dev 専用 secret。",
      "enabled": true,
      "publicClient": false,
      "secret": "shiki-provisioner-dev-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocolMappers": [
        {
          "name": "shiki-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "shiki-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "id": "00000000-0000-0000-0000-000000000001",
      "username": "alice",
      "enabled": true,
      "emailVerified": true,
      "email": "alice@a-corp.example.com",
      "firstName": "Alice",
      "lastName": "Acorp",
      "attributes": {
        "roles": [
          "engineering",
          "sales-div",
          "sales"
        ],
        "tenant": [
          "a-corp"
        ]
      },
      "groups": [
        "/tenants/a-corp/a-corp"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-shiki"
      ]
    },
    {
      "id": "00000000-0000-0000-0000-000000000002",
      "username": "bob",
      "enabled": true,
      "emailVerified": true,
      "email": "bob@a-corp.example.com",
      "firstName": "Bob",
      "lastName": "Acorp",
      "attributes": {
        "roles": [
          "engineering",
          "sales"
        ],
        "tenant": [
          "a-corp"
        ]
      },
      "groups": [
        "/tenants/a-corp/a-corp"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-shiki"
      ]
    },
    {
      "id": "00000000-0000-0000-0000-000000000003",
      "username": "charlie",
      "enabled": true,
      "emailVerified": true,
      "email": "charlie@b-corp.example.com",
      "firstName": "Charlie",
      "lastName": "Bcorp",
      "attributes": {
        "roles": [
          "engineering"
        ],
        "tenant": [
          "b-corp"
        ]
      },
      "groups": [
        "/tenants/b-corp/b-corp"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-shiki"
      ]
    },
    {
      "username": "service-account-shiki-provisioner",
      "enabled": true,
      "serviceAccountClientId": "shiki-provisioner",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "manage-realm",
          "query-groups",
          "query-users",
          "manage-clients"
        ]
      }
    }
  ]
}
