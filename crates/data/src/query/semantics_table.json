{
  "about": "クエリ条件の 2 値論理の共通テスト表（query-optimizer.md §3.1・Task 15.7）。data の評価器（crates/data/src/query/semantics_tests.rs）と workflow の評価器（crates/workflow-engine/src/control/eval_semantics_tests.rs）の両方がこの表を読み、同じ結果を返すことを固定する。value を省いた行は「値なし」。type は text（単値の文字列）・number（単値の数値）・multi_select（文字列の多値）。",
  "cases": [
    { "type": "text", "value": "abc", "op": "eq", "operand": "abc", "expect": true },
    { "type": "text", "value": "abc", "op": "eq", "operand": "ab", "expect": false },
    { "type": "text", "value": "abc", "op": "neq", "operand": "ab", "expect": true },
    { "type": "text", "value": "abc", "op": "neq", "operand": "abc", "expect": false },
    { "type": "text", "value": "abc", "op": "in", "operand": ["x", "abc"], "expect": true },
    { "type": "text", "value": "abc", "op": "in", "operand": ["x"], "expect": false },
    { "type": "text", "value": "abc", "op": "contains", "operand": "b", "expect": true },
    { "type": "text", "value": "abc", "op": "contains", "operand": "z", "expect": false },
    { "type": "text", "value": "abc", "op": "starts_with", "operand": "ab", "expect": true },
    { "type": "text", "value": "abc", "op": "starts_with", "operand": "bc", "expect": false },
    { "type": "text", "value": "abc", "op": "ends_with", "operand": "bc", "expect": true },
    { "type": "text", "value": "abc", "op": "lt", "operand": "b", "expect": true },
    { "type": "text", "value": "abc", "op": "gt", "operand": "b", "expect": false },
    { "type": "text", "value": "abc", "op": "gte", "operand": "abc", "expect": true },
    { "type": "text", "value": "abc", "op": "exists", "expect": true },
    { "type": "text", "value": "abc", "op": "is_null", "expect": false },

    { "type": "text", "op": "eq", "operand": "abc", "expect": false },
    { "type": "text", "op": "neq", "operand": "abc", "expect": true },
    { "type": "text", "op": "in", "operand": ["abc"], "expect": false },
    { "type": "text", "op": "contains", "operand": "a", "expect": false },
    { "type": "text", "op": "starts_with", "operand": "a", "expect": false },
    { "type": "text", "op": "ends_with", "operand": "a", "expect": false },
    { "type": "text", "op": "lt", "operand": "b", "expect": false },
    { "type": "text", "op": "gt", "operand": "b", "expect": false },
    { "type": "text", "op": "exists", "expect": false },
    { "type": "text", "op": "is_null", "expect": true },

    { "type": "number", "value": 1, "op": "eq", "operand": 1, "expect": true },
    { "type": "number", "value": 1, "op": "eq", "operand": 1.0, "expect": true },
    { "type": "number", "value": 1.0, "op": "eq", "operand": 1, "expect": true },
    { "type": "number", "value": 1, "op": "eq", "operand": 2, "expect": false },
    { "type": "number", "value": 1, "op": "neq", "operand": 1.0, "expect": false },
    { "type": "number", "value": 1, "op": "neq", "operand": 2, "expect": true },
    { "type": "number", "value": 1, "op": "in", "operand": [1.0, 5], "expect": true },
    { "type": "number", "value": 1, "op": "in", "operand": [2, 3], "expect": false },
    { "type": "number", "value": 1, "op": "lt", "operand": 1.5, "expect": true },
    { "type": "number", "value": 1, "op": "lte", "operand": 1.0, "expect": true },
    { "type": "number", "value": 1, "op": "gt", "operand": 0.5, "expect": true },
    { "type": "number", "value": 1, "op": "gt", "operand": 1, "expect": false },
    { "type": "number", "value": 2.5, "op": "eq", "operand": 2.5, "expect": true },
    { "type": "number", "value": 2.5, "op": "gte", "operand": 2.5, "expect": true },
    { "type": "number", "value": -3, "op": "lt", "operand": 0, "expect": true },
    { "type": "number", "value": 9007199254740993, "op": "eq", "operand": 9007199254740992, "expect": false },
    { "type": "number", "value": 9007199254740993, "op": "gt", "operand": 9007199254740992, "expect": true },
    { "type": "number", "value": 1, "op": "exists", "expect": true },
    { "type": "number", "value": 0, "op": "exists", "expect": true },
    { "type": "number", "value": 1, "op": "is_null", "expect": false },

    { "type": "number", "op": "eq", "operand": 1, "expect": false },
    { "type": "number", "op": "neq", "operand": 1, "expect": true },
    { "type": "number", "op": "in", "operand": [1], "expect": false },
    { "type": "number", "op": "lt", "operand": 5, "expect": false },
    { "type": "number", "op": "gte", "operand": 0, "expect": false },
    { "type": "number", "op": "exists", "expect": false },
    { "type": "number", "op": "is_null", "expect": true },

    { "type": "multi_select", "value": ["a", "b"], "op": "eq", "operand": "a", "expect": true },
    { "type": "multi_select", "value": ["a", "b"], "op": "eq", "operand": "c", "expect": false },
    { "type": "multi_select", "value": ["a", "b"], "op": "neq", "operand": "a", "expect": false },
    { "type": "multi_select", "value": ["a", "b"], "op": "neq", "operand": "c", "expect": true },
    { "type": "multi_select", "value": ["a", "b"], "op": "in", "operand": ["c", "b"], "expect": true },
    { "type": "multi_select", "value": ["a", "b"], "op": "in", "operand": ["c"], "expect": false },
    { "type": "multi_select", "value": ["a", "b"], "op": "exists", "expect": true },
    { "type": "multi_select", "value": ["a", "b"], "op": "is_null", "expect": false },
    { "type": "multi_select", "value": ["a"], "op": "eq", "operand": "a", "expect": true },
    { "type": "multi_select", "value": ["alpha", "beta"], "op": "contains", "operand": "lph", "expect": true },
    { "type": "multi_select", "value": ["alpha", "beta"], "op": "contains", "operand": "alpha", "expect": true },
    { "type": "multi_select", "value": ["alpha", "beta"], "op": "contains", "operand": "x", "expect": false },
    { "type": "multi_select", "value": ["alpha", "beta"], "op": "starts_with", "operand": "be", "expect": true },
    { "type": "multi_select", "value": ["alpha", "beta"], "op": "starts_with", "operand": "lp", "expect": false },
    { "type": "multi_select", "value": ["alpha", "beta"], "op": "ends_with", "operand": "ta", "expect": true },

    { "type": "multi_select", "value": [], "op": "eq", "operand": "a", "expect": false },
    { "type": "multi_select", "value": [], "op": "neq", "operand": "a", "expect": true },
    { "type": "multi_select", "value": [], "op": "in", "operand": ["a"], "expect": false },
    { "type": "multi_select", "value": [], "op": "contains", "operand": "a", "expect": false },
    { "type": "multi_select", "value": [], "op": "exists", "expect": false },
    { "type": "multi_select", "value": [], "op": "is_null", "expect": true },

    { "type": "multi_select", "op": "eq", "operand": "a", "expect": false },
    { "type": "multi_select", "op": "neq", "operand": "a", "expect": true },
    { "type": "multi_select", "op": "in", "operand": ["a"], "expect": false },
    { "type": "multi_select", "op": "contains", "operand": "a", "expect": false },
    { "type": "multi_select", "op": "exists", "expect": false },
    { "type": "multi_select", "op": "is_null", "expect": true }
  ]
}
