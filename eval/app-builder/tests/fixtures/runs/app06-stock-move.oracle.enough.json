     "id": "find",
     "type": "data.query",
     "label": "品番で探す",
     "params": {
      "table": "b2f1f90b-c340-4b40-baf3-65c859a319ae",
      "query": {
       "filter": {
        "cmp": {
         "field": "code",
         "op": "eq",
         "value": {
          "$from": "input",
          "path": "/code"
         }
        }
       },
       "limit": 1
      }
     }
    },
    {
     "id": "enough",
     "type": "control.branch",
     "label": "在庫が足りるか",
     "params": {
      "condition": {
       "cmp": {
        "left": {
         "$from": "nodes.find.output",
         "path": "/items/0/data/qty"
        },
        "op": "gte",
        "right": {
         "$from": "input",
         "path": "/qty"
        }
       }
      }
     }
    },
    {
     "id": "negate",
     "type": "script.run",
     "label": "減らす数",
     "params": {
      "source": {
       "inline": "function main(input) { return { delta: -Number(input.qty) }; }"
      },
      "input": {
       "qty": {
        "$from": "input",
        "path": "/qty"
       }
      }
     }
    },
    {
     "id": "take",
     "type": "data.record.update",
     "label": "在庫数を減らす",
     "params": {
      "table": "b2f1f90b-c340-4b40-baf3-65c859a319ae",
      "record": {
       "$from": "nodes.find.output",
       "path": "/items/0/id"
      },
      "add": {
       "qty": {
        "$from": "nodes.negate.output",
        "path": "/delta"
       }
      }
     }
    },
    {
     "id": "log",
     "type": "data.record.create",
     "label": "記録を残す",
     "params": {
      "table": "49791bdb-8283-4dff-af80-11280a7e0a0f",
      "data": {
       "code": {
        "$from": "input",
        "path": "/code"
       },
       "qty": {
        "$from": "input",
        "path": "/qty"
       }
      }
     }
    }
   ],
   "edges": [
