      "type": "number"
     }
    },
    "required": [
     "code",
     "qty"
    ],
    "x-order": [
     "code",
     "qty"
    ]
   },
   "nodes": [
    {
     "id": "find",
     "type": "data.query",
     "label": "品番で探す",
     "params": {
      "table": "d48730cb-d3e0-4101-9e87-a44f6e7338bd",
      "query": {
       "filter": {
        "cmp": {
         "field": "code",
         "op": "eq",
         "value": {
          "$from": "input",
          "path": "/code"
         }
        }
       },
       "limit": 1
      }
     }
    },
    {
     "id": "enough",
     "type": "control.branch",
     "label": "在庫が足りるか",
     "params": {
      "condition": {
       "cmp": {
        "left": {
         "$from": "nodes.find.output",
         "path": "/items/0/data/qty"
        },
        "op": "gte",
        "right": {
         "$from": "input",
         "path": "/qty"
        }
       }
      }
     }
    },
    {
     "id": "rest",
     "type": "script.run",
     "label": "残りの数",
     "params": {
      "source": {
       "inline": "function main(input) { return { rest: Number(input.stock) - Number(input.qty) }; }"
      },
      "input": {
       "stock": {
        "$from": "nodes.find.output",
        "path": "/items/0/data/qty"
       },
       "qty": {
        "$from": "input",
        "path": "/qty"
       }
      }
     }
    },
    {
     "id": "take",
     "type": "data.record.update",
     "label": "在庫数を減らす",
     "params": {
      "table": "d48730cb-d3e0-4101-9e87-a44f6e7338bd",
      "record": {
       "$from": "nodes.find.output",
       "path": "/items/0/id"
      },
      "patch": {
       "qty": {
        "$from": "nodes.rest.output",
        "path": "/rest"
       }
      }
     }
    },
    {
     "id": "log",
     "type": "data.record.create",
     "label": "記録を残す",
     "params": {
      "table": "2d30b646-475b-471e-a139-1fe777ba0534",
      "data": {
       "code": {
        "$from": "input",
        "path": "/code"
       },
       "qty": {
        "$from": "input",
        "path": "/qty"
       }
      }
     }
    }
   ],
   "edges": [
    {
     "from": "find",
     "to": "enough"
    },
    {
     "from": "enough",
