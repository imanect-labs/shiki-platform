     "qty"
    ]
   },
   "nodes": [
    {
     "id": "find",
     "type": "data.query",
     "label": "品番で探す",
     "params": {
      "table": "1b143439-0aec-4579-965e-aaf2a86abee1",
      "query": {
       "filter": {
        "cmp": {
         "field": "code",
         "op": "eq",
         "value": {
          "$from": "input",
          "path": "/code"
         }
        }
       },
       "limit": 1
      }
     }
    },
    {
     "id": "enough",
     "type": "control.branch",
     "label": "在庫が足りるか",
     "params": {
      "condition": {
       "cmp": {
        "left": {
         "$from": "nodes.find.output",
         "path": "/items/0/data/qty"
        },
        "op": "gte",
        "right": {
         "$from": "input",
         "path": "/qty"
        }
       }
      }
     }
    },
    {
     "id": "negate",
     "type": "script.run",
     "label": "減らす数",
     "params": {
      "source": {
       "inline": "function main(input) { return { delta: -Number(input.qty) }; }"
      },
      "input": {
       "qty": {
        "$from": "input",
        "path": "/qty"
       }
      }
     }
    },
    {
     "id": "take",
     "type": "data.record.update",
     "label": "在庫数を減らす",
     "params": {
      "table": "1b143439-0aec-4579-965e-aaf2a86abee1",
      "record": {
       "$from": "nodes.find.output",
       "path": "/items/0/id"
      },
      "add": {
       "qty": {
        "$from": "nodes.negate.output",
        "path": "/delta"
       }
      }
     }
    },
    {
     "id": "log",
     "type": "data.record.create",
     "label": "記録を残す",
     "params": {
      "table": "e6c99b56-ea39-4b26-8e00-2b50aa53de13",
      "data": {
       "code": {
        "$from": "input",
        "path": "/code"
       },
       "qty": {
        "$from": "input",
        "path": "/qty"
       }
      }
     }
    }
   ],
   "edges": [
    {
     "from": "find",
     "to": "enough"
    },
    {
     "from": "enough",
