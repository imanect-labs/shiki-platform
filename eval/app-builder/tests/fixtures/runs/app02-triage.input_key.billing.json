   },
   "nodes": [
    {
     "id": "register",
     "type": "data.record.create",
     "label": "問い合わせを登録",
     "params": {
      "table": "617a6b49-4d94-4c71-98cf-157bfa130fb7",
      "data": {
       "subject": {
        "$from": "input",
        "path": "/subject_x"
       },
       "body": {
        "$from": "input",
        "path": "/body"
       },
       "status": "未対応"
      }
     }
    },
    {
     "id": "classify",
     "type": "llm.invoke",
     "label": "分類を決める",
     "params": {
      "prompt": {
       "$template": "次の問い合わせを読み、分類を「請求」「不具合」「使い方」のどれか 1 つに決めてください。答えには分類の語だけを書いてください。\n件名: {subject}\n本文: {body}",
       "vars": {
        "subject": {
         "$from": "input",
         "path": "/subject_x"
        },
        "body": {
         "$from": "input",
         "path": "/body"
        }
       }
      },
      "model": "default"
     }
    },
    {
     "id": "pick",
     "type": "script.run",
     "label": "分類の語を取り出す",
     "params": {
      "source": {
       "inline": "function main(input) {\n  var text = String(input.text || \"\");\n  var found = null;\n  var at = -1;\n  [\"請求\", \"不具合\", \"使い方\"].forEach(function (c) {\n    var i = text.indexOf(c);\n    if (i >= 0 && (at < 0 || i < at)) {\n      found = c;\n      at = i;\n    }\n  });\n  if (found === null) {\n    throw new Error(\"分類を読み取れません: \" + text.slice(0, 100));\n  }\n  return { category: found };\n}"
      },
      "input": {
       "$from": "nodes.classify.output"
      }
     }
    },
    {
     "id": "find_assignee",
     "type": "data.query",
     "label": "担当者を引く",
     "params": {
      "table": "9f6960a7-fdf1-4265-b5bf-5527afd9bf0e",
      "query": {
       "filter": {
        "cmp": {
         "field": "category",
         "op": "eq",
         "value": {
          "$from": "nodes.pick.output",
          "path": "/category"
         }
        }
       },
       "limit": 1
      }
     }
    },
    {
     "id": "assign",
     "type": "data.record.update",
     "label": "分類と担当者を書く",
     "params": {
      "table": "617a6b49-4d94-4c71-98cf-157bfa130fb7",
      "record": {
       "$from": "nodes.register.output",
       "path": "/id"
      },
      "patch": {
       "category": {
        "$from": "nodes.pick.output",
        "path": "/category"
       },
       "assignee": {
        "$from": "nodes.find_assignee.output",
        "path": "/items/0/data/assignee"
       }
      }
     }
    },
    {
     "id": "mark_triaged",
     "type": "data.transition",
     "label": "振り分け済にする",
     "params": {
      "table": "617a6b49-4d94-4c71-98cf-157bfa130fb7",
      "record": {
       "$from": "nodes.register.output",
       "path": "/id"
      },
      "to": "振り分け済"
     }
    }
   ],
   "edges": [
    {
     "from": "register",
