{
 "task": "app03-weekly-summary",
 "variant": "escape_var",
 "case": "last_week",
 "irs": {
  "main": {
   "ir_version": 1,
   "name": "abeval-rec-25f9ce-escape-var",
   "display_name": "日報を週ごとに集計する",
   "triggers": [
    {
     "kind": "schedule",
     "cron": "0 9 * * 1",
     "tz": "Asia/Tokyo"
    }
   ],
   "nodes": [
    {
     "id": "last_week",
     "type": "transform.date",
     "label": "先週",
     "params": {
      "shift": {
       "amount": -1,
       "unit": "week"
      },
      "period": "week"
     }
    },
    {
     "id": "totals",
     "type": "data.query",
     "label": "担当者ごとの合計",
     "params": {
      "table": "5c8e7afe-1c40-4c3a-a049-5118737bffa8",
      "query": {
       "filter": {
        "all": [
         {
          "cmp": {
           "field": "report_date",
           "op": "gte",
           "value": {
            "$from": "nodes.last_week.output",
            "path": "/start"
           }
          }
         },
         {
          "cmp": {
           "field": "report_date",
           "op": "lte",
           "value": {
            "$from": "nodes.last_week.output",
            "path": "/end"
           }
          }
         }
        ]
       },
       "group_by": [
        "rep"
       ],
       "aggregate": [
        {
         "metric": "sum",
         "field": "visits"
        },
        {
         "metric": "sum",
         "field": "prospect"
        }
       ]
      }
     }
    },
    {
     "id": "per_rep",
     "type": "control.map",
     "label": "担当者ごと",
     "params": {
      "items": {
       "$from": "nodes.totals.output",
       "path": "/groups"
      }
     }
    },
    {
     "id": "save_total",
     "type": "data.record.create",
     "label": "週次集計に追加",
     "params": {
      "table": "7b4c3a7d-03f1-4f40-acde-9b5bfb2a9afa",
      "data": {
       "week_start": {
        "$from": "nodes.last_week.output",
        "path": "/start"
       },
       "rep": {
        "$from": "each",
        "path": "/item/key/rep"
       },
       "visits": {
        "$from": "each",
        "path": "/item/values/0"
       },
       "prospect": {
        "$from": "each",
        "path": "/item/values/1"
       }
      }
     },
     "parent": "per_rep"
    },
    {
     "id": "summarize",
     "type": "llm.invoke",
     "label": "週報の文章",
     "params": {
      "prompt": {
       "$template": "{{start}} から {end} までの営業の日報の集計です。担当者ごとの訪問件数と見込み額の合計を、読みやすい短い週報にまとめてください。\n{groups}",
       "vars": {
        "start": {
         "$from": "nodes.last_week.output",
         "path": "/start"
        },
        "end": {
         "$from": "nodes.last_week.output",
         "path": "/end"
        },
        "groups": {
         "$from": "nodes.totals.output",
         "path": "/groups"
        }
       }
      },
      "model": "default"
     }
    },
    {
     "id": "save_file",
     "type": "storage.write",
     "label": "週報を保存",
     "params": {
      "folder": "6fbccfac-bc55-4967-865b-83c72318027d",
      "name": {
       "$template": "週報-{start}.md",
       "vars": {
        "start": {
         "$from": "nodes.last_week.output",
         "path": "/start"
        }
       }
      },
      "content": {
       "$from": "nodes.summarize.output",
       "path": "/text"
      },
      "content_type": "text/markdown",
      "on_name_taken": "add_number"
     }
    }
   ],
   "edges": [
    {
     "from": "last_week",
     "to": "totals"
    },
    {
     "from": "totals",
     "to": "per_rep"
    },
    {
     "from": "per_rep",
     "to": "summarize"
    },
    {
     "from": "summarize",
     "to": "save_file"
    }
   ]
  }
 },
 "node_ports": {
  "main": {
   "last_week": [
    "out"
   ],
   "per_rep": [
    "out"
   ],
   "save_file": [
    "out"
   ],
   "save_total": [
    "out"
   ],
   "summarize": [
    "out"
   ],
   "totals": [
    "out"
   ]
  }
 },
