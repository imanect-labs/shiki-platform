   "name": "abeval-rec-5f3c10-main",
   "display_name": "出庫で在庫を減らす",
   "triggers": [
    {
     "kind": "interactive"
    }
   ],
   "input_schema": {
    "type": "object",
    "properties": {
     "code": {
      "type": "string"
     },
