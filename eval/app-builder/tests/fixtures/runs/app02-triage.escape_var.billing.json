   "triggers": [
    {
     "kind": "interactive"
    }
   ],
   "input_schema": {
    "type": "object",
    "properties": {
     "subject": {
      "type": "string"
     },
     "body": {
      "type": "string"
     }
    },
    "required": [
     "subject",
     "body"
