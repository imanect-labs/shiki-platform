{
 "task": "app11-overdue",
 "variant": "escape_var",
 "case": "morning",
 "irs": {
  "main": {
   "ir_version": 1,
   "name": "abeval-rec-0c9885-escape-var",
   "display_name": "延滞の一覧を作る",
   "triggers": [
    {
     "kind": "schedule",
     "cron": "0 9 * * *",
     "tz": "Asia/Tokyo"
    }
   ],
   "nodes": [
    {
     "id": "today",
     "type": "transform.date",
     "label": "今日",
     "params": {}
    },
    {
     "id": "late",
     "type": "data.query",
     "label": "延滞している記録",
     "params": {
      "table": "f0e572cf-bb0c-4ea4-b051-75e63cb69a1c",
      "query": {
       "filter": {
        "all": [
         {
          "cmp": {
           "field": "due_on",
           "op": "lt",
           "value": {
            "$from": "nodes.today.output",
            "path": "/date"
           }
          }
         },
         {
          "cmp": {
           "field": "returned_on",
           "op": "is_null"
          }
         }
        ]
       },
       "sort": [
        {
         "field": "due_on"
        }
       ],
       "limit": 200
      }
     }
    },
    {
     "id": "format",
     "type": "script.run",
     "label": "一覧の文章",
     "params": {
      "source": {
       "inline": "function main(input) {\n  var lines = (input.items || []).map(function (r) {\n    return \"- \" + r.data.code + \" \" + r.data.borrower + \"（返却予定日 \" + r.data.due_on + \"）\";\n  });\n  return { text: \"# 延滞の一覧（\" + input.date + \"）\\n\\n\" + (lines.length ? lines.join(\"\\n\") : \"延滞はありません。\") + \"\\n\" };\n}"
      },
      "input": {
       "items": {
        "$from": "nodes.late.output",
        "path": "/items"
       },
       "date": {
        "$from": "nodes.today.output",
        "path": "/date"
       }
      }
     }
    },
    {
     "id": "save",
     "type": "storage.write",
     "label": "一覧を保存",
     "params": {
      "folder": "31a63f59-1425-4983-9f0c-e94968a0c87a",
      "name": {
       "$template": "延滞一覧-{{date}}.md",
       "vars": {
        "date": {
         "$from": "nodes.today.output",
         "path": "/date"
        }
       }
      },
      "content": {
       "$from": "nodes.format.output",
       "path": "/text"
      },
      "content_type": "text/markdown",
      "on_name_taken": "add_number"
     }
    }
   ],
   "edges": [
    {
     "from": "today",
     "to": "late"
    },
    {
     "from": "late",
     "to": "format"
    },
    {
     "from": "format",
     "to": "save"
    }
   ]
  }
 },
 "node_ports": {
  "main": {
   "format": [
    "out"
   ],
   "late": [
    "out"
   ],
   "save": [
    "out"
   ],
   "today": [
    "out"
   ]
  }
 },
