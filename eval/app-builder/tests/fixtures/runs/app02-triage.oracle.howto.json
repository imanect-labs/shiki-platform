{
 "task": "app02-triage",
 "variant": "oracle",
 "case": "howto",
 "irs": {
  "main": {
   "ir_version": 1,
   "name": "abeval-rec-be230a-main",
   "display_name": "問い合わせを分類して担当を決める",
   "triggers": [
    {
     "kind": "interactive"
    }
   ],
   "input_schema": {
    "type": "object",
    "properties": {
     "subject": {
      "type": "string"
     },
     "body": {
      "type": "string"
     }
    },
    "required": [
     "subject",
     "body"
    ],
    "x-order": [
     "subject",
     "body"
    ]
   },
   "nodes": [
    {
     "id": "register",
     "type": "data.record.create",
     "label": "問い合わせを登録",
     "params": {
      "table": "0b353389-8f1a-447b-85ba-6766340483d3",
      "data": {
       "subject": {
        "$from": "input",
        "path": "/subject"
       },
       "body": {
        "$from": "input",
        "path": "/body"
       },
       "status": "未対応"
      }
     }
    },
    {
     "id": "classify",
     "type": "llm.invoke",
     "label": "分類を決める",
     "params": {
      "prompt": {
       "$template": "次の問い合わせを読み、理由を 1 文で書いてから、分類を決めてください。\n件名: {subject}\n本文: {body}",
       "vars": {
        "subject": {
         "$from": "input",
         "path": "/subject"
        },
        "body": {
         "$from": "input",
         "path": "/body"
        }
       }
      },
      "output_schema": {
       "type": "object",
       "required": [
        "reason",
        "category"
       ],
       "x-order": [
        "reason",
        "category"
       ],
       "properties": {
        "reason": {
         "type": "string",
         "maxLength": 200
        },
        "category": {
         "type": "string",
         "enum": [
          "請求",
          "不具合",
          "使い方"
         ]
        }
       }
      },
      "model": "default"
     }
    },
    {
     "id": "find_assignee",
     "type": "data.query",
     "label": "担当者を引く",
     "params": {
      "table": "37a5ce1e-723e-4864-a03b-d8ee834feb92",
      "query": {
       "filter": {
        "cmp": {
         "field": "category",
         "op": "eq",
         "value": {
          "$from": "nodes.classify.output",
          "path": "/data/category"
         }
        }
       },
       "limit": 1
      }
     }
    },
    {
     "id": "assign",
     "type": "data.record.update",
     "label": "分類と担当者を書く",
     "params": {
      "table": "0b353389-8f1a-447b-85ba-6766340483d3",
      "record": {
       "$from": "nodes.register.output",
       "path": "/id"
      },
      "patch": {
       "category": {
        "$from": "nodes.classify.output",
        "path": "/data/category"
       },
       "assignee": {
        "$from": "nodes.find_assignee.output",
        "path": "/items/0/data/assignee"
       },
       "status": "振り分け済"
      }
     }
    }
   ],
   "edges": [
    {
     "from": "register",
     "to": "classify"
    },
    {
     "from": "classify",
     "to": "find_assignee"
    },
    {
     "from": "find_assignee",
     "to": "assign"
    }
   ]
  }
 },
 "node_ports": {
  "main": {
   "assign": [
    "out"
   ],
   "classify": [
    "out"
   ],
   "find_assignee": [
    "out"
   ],
   "register": [
    "out"
   ]
  }
 },
