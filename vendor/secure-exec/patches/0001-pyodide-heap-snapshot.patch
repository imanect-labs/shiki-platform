+fn link_or_copy_snapshot_file(source: &Path, target: &Path) -> std::io::Result<()> {
+    if target.exists() {
+        return Ok(());
+    }
+    fs::hard_link(source, target).or_else(|_| fs::copy(source, target).map(|_| ()))
+}
